{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-cmd-signaling-local",
  "main": "worker.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "SignalingRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingRoom"] }],
  "env": {
    "public": {
      "name": "live-cmd-signaling",
      "workers_dev": true,
      "vars": {
        "PUBLIC": "1",
        "TURN_URLS": "turn:turn.yagoriccomi.com.br:3478?transport=udp,turn:turn.yagoriccomi.com.br:3478?transport=tcp,turns:turn.yagoriccomi.com.br:5349?transport=tcp",
        "TURN_SERVICE": "live-cmd"
      },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "SignalingRoom" }] }
    }
  }
}
